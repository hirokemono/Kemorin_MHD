array compare_surface_file
  begin compare_surface_file
    begin first_file_ctl
      section_file_prefix    'reference/zonal_mean'
      section_file_format            PSF_gz
    end first_file_ctl
    begin second_file_ctl
      section_file_prefix    'sections/zonal_mean'
      section_file_format            PSF_gz
    end second_file_ctl
!
    i_step_surface_ctl         20
    difference_limit_ctl    1.0e-9
  end compare_surface_file
!
  begin compare_surface_file
    begin first_file_ctl
      section_file_prefix    'reference/equator'
      section_file_format            PSF_gz
    end first_file_ctl
    begin second_file_ctl
      section_file_prefix    'sections/equator'
      section_file_format            PSF_gz
    end second_file_ctl
!
    i_step_surface_ctl        20
    difference_limit_ctl    1.0e-9
  end compare_surface_file
end array compare_surface_file
!
