array compare_surface_file
  begin compare_surface_file
    begin first_file_ctl
      surface_file_prefix    'reference/zonal_mean'
      surface_file_format            binary_gzip
    end first_file_ctl
    begin second_file_ctl
      surface_file_prefix    'sections/zonal_mean'
      surface_file_format            binary_gzip
    end second_file_ctl
!
    i_step_surface_ctl         10
    difference_limit_ctl    1.0e-9
  end compare_surface_file
!
  begin compare_surface_file
    begin first_file_ctl
