!
!
!     example of control for Kemo's field line
!
begin fieldline
  fline_file_prefix    'fieldline/b_line_a'
  fline_output_format   VTK
!
  array chosen_ele_grp_ctl
    chosen_ele_grp_ctl   all
  end array chosen_ele_grp_ctl
!
!  starting_type:    position_list, surface_list,  or surface_group
  line_direction_ctl        both
  max_line_stepping_ctl     10000
!  max_trace_length_ctl         0.2
  starting_type_ctl     position_list
!
!  start_surf_grp_ctl      ICB
!  num_fieldline_ctl       100
!
!  selection_type_ctl:    amplitude, area_size
  selection_type_ctl     amplitude
!
  begin seed_lists_ctl
    array seed_point_ctl
      seed_point_ctl  1.05  0.1   0.05
      seed_point_ctl  -0.77  0.65  0.07
      seed_point_ctl  0.1  -1.05  -0.2
      seed_point_ctl  -0.68  -1.05  -0.2
      seed_point_ctl   0.5   0.5  -0.5
      seed_point_ctl   0.5  -0.5  -0.5
      seed_point_ctl  -0.5  -0.5  -0.5
      seed_point_ctl  -0.5   0.5  -0.5
    end array seed_point_ctl
!
    array seed_geological_ctl
      seed_geological_ctl  1.03    45.0      0.0
      seed_geological_ctl  1.03    45.0     90.0
      seed_geological_ctl  1.03    45.0    180.0
      seed_geological_ctl  1.03    45.0    270.0
      seed_geological_ctl  1.03    36.5    140.0
    end array seed_geological_ctl
!
    array seed_spherical_ctl
      seed_spherical_ctl 0.75    1.047197551196598    3.141592653589793
    end array seed_spherical_ctl
  end seed_lists_ctl
!
!  array starting_gl_surface_id
!    starting_gl_surface_id  12  3
!  end array starting_gl_surface_id
!
!   field type:
!     scalar, vector, sym_tensor, asym_tensor
!     spherical_vector,   spherical_sym_tensor
!     cylindrical_vector, cylindrical_sym_tensor
!     norm, 
!
  field_line_field_ctl      magnetic_field   end
  coloring_field_ctl        magnetic_field   end
  coloring_comp_ctl        radial   end
!
  array output_field
    output_field     magnetic_field    spherical_vector
    output_field     temperature     scalar
!    output_field     temperature     scalar
!    output_field     magnetic_field  spherical_vector
    output_field     velocity        cylindrical_vector
  end array output_field
!
end fieldline
