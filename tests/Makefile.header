#
# -----------------------------------------------------------
# Makefile header for Kemorin Dynamo tests
# -----------------------------------------------------------
#
#
SHELL = /bin/sh
#
#  all:         compile programs for simulations
#  utils_pg:    compile programs for 2d-drawing (PGPLOT is required)
#  viewer_gtk:  compile programs for gtk viewer  (GLUT & GTK are required)
#
# Compiler commands
#
CC=gcc
F90=mpif90
CXX=
AS=gcc
AR=ar
RANLIB=ranlib
F90_LOCAL=mpif90
MPIRUN=mpirun
#
# Compiler options
#
F90OPTFLAGS = -O3 -Wall -g -fopenmp  $(F_INCLUDE)
F90CPPFLAGS =  -DPNG_OUTPUT -DZLIB_IO -DFFTW3 -DBLAS -DHDF5_IO -DGLFW3 -DFFMPEG
F90DLLFLAGS = -fPIC $(F90OPTFLAGS)
OPTFLAGS = -O3 -Wall -g  -D__APPLE__
CXXFLAGS =  -D__APPLE__
#
# Libralies and includes settting
#

F90LIBS =   $(PNG_LIBS) $(ZLIB_LIBS) $(FFTW3_LIBS) $(BLAS_LIBS) $(HDF5_LDFLAGS) $(HDF5_FLIBS)
F_INCLUDE = -I. -I$(MAKEDIR) $(HDF5_FFLAGS)
C_INCLUDE = -I. -I$(MAKEDIR) -I/Users/matsui/src_kemo/MHD/C_src/CORE_C -I/Users/matsui/src_kemo/MHD/C_src/CONTROLS $(PNG_CFLAGS)  $(ZLIB_CFLAGS)  $(FFTW3_CFLAGS) -I/Users/matsui/src_kemo/MHD/C_src/KEMO_GL -I/Users/matsui/src_kemo/MHD/C_src/GLSL -I/Users/matsui/src_kemo/MHD/C_src/GTK -I/Users/matsui/src_kemo/MHD/C_src/KEMO_GLUT

#
# zlib settings
#
ZLIB_CFLAGS = -I/opt/homebrew/include -I /opt/homebrew/Cellar/hdf5-mpi/1.14.6/include -I/opt/homebrew/opt/zlib/include
ZLIB_LIBS =   -L/opt/homebrew/opt/zlib/lib -lz 
#
# libpng settings
#
PNG_CFLAGS = -I/opt/homebrew/opt/libpng/include/libpng16
PNG_LIBS =    -L/opt/homebrew/opt/libpng/lib -lpng16
#
#   AMD ROCm settings
#
ROCM_PATH =     
ROCM_CFLAGS =   
ROCM_FCFLAGS =  
ROCM_LIBDIR =   
ROCM_LIBS =     
ROCM_ROCPROFV2_LDFLAGS =   
ROCM_ROCPROFSDK_LDFLAGS =  
#
# BLAS settings
#
BLAS_LIBS =   -lblas
#
# FFTW3 settings
#
FFTW3_CFLAGS =   -I/opt/homebrew/Cellar/fftw/3.3.10_2/include
FFTW3_LIBS =     -L/opt/homebrew/Cellar/fftw/3.3.10_2/lib -lfftw3
FFTW3_OMP_LIBS = 
#
# HDF5 settings
#
HDF5_FFLAGS = -I/opt/homebrew/lib -L/opt/homebrew/lib -I/opt/homebrew/include 
HDF5_LDFLAGS = -L/opt/homebrew/lib 
HDF5_FLIBS = -L/opt/homebrew/lib -lhdf5_fortran -lhdf5
#
# PGPLOT Libralies
#
PGPLOT_LIBS = 
#
#
# OpenGL settings
#
OPENGL_INC =  
OPENGL_LIBS = -framework OpenGL  -framework CoreVideo  -framework IOKit -framework Cocoa $(PNG_LIBS) $(ZLIB_LIBS) -framework accelerate
OPTFLAGS_GL = $(OPTFLAGS)  -DPNG_OUTPUT -DZLIB_IO -DFFTW3 -DBLAS -DHDF5_IO -DGLFW3 -DFFMPEG $(OPENGL_INC) $(PNG_CFLAGS)  
#
# GTK settings
#
GTK3_CFLAGS =  -I/opt/homebrew/Cellar/gtk+3/3.24.50/include/gtk-3.0 -I/opt/homebrew/Cellar/pango/1.57.0/include/pango-1.0 -I/opt/homebrew/Cellar/harfbuzz/12.0.0/include/harfbuzz -I/opt/homebrew/Cellar/graphite2/1.3.14/include -I/opt/homebrew/Cellar/cairo/1.18.4/include -I/opt/homebrew/Cellar/cairo/1.18.4/include/cairo -I/opt/homebrew/Cellar/fontconfig/2.17.1/include -I/opt/homebrew/opt/freetype/include/freetype2 -I/opt/homebrew/Cellar/libxext/1.3.6/include -I/opt/homebrew/Cellar/xorgproto/2024.1/include -I/opt/homebrew/Cellar/libxrender/0.9.12/include -I/opt/homebrew/Cellar/libx11/1.8.12/include -I/opt/homebrew/Cellar/libxcb/1.17.0/include -I/opt/homebrew/Cellar/libxau/1.0.12/include -I/opt/homebrew/Cellar/libxdmcp/1.1.5/include -I/opt/homebrew/Cellar/pixman/0.46.4/include/pixman-1 -I/opt/homebrew/include/gdk-pixbuf-2.0 -I/opt/homebrew/opt/libpng/include/libpng16 -I/opt/homebrew/opt/libtiff/include -I/opt/homebrew/opt/zstd/include -I/opt/homebrew/Cellar/xz/5.8.2/include -I/opt/homebrew/opt/jpeg-turbo/include -I/opt/homebrew/Cellar/at-spi2-core/2.58.0/include/atk-1.0 -I/opt/homebrew/Cellar/libepoxy/1.5.10/include -I/opt/homebrew/Cellar/fribidi/1.0.16/include/fribidi -I/opt/homebrew/Cellar/glib/2.86.0/include/gio-unix-2.0 -I/opt/homebrew/Cellar/glib/2.86.0/include -I/Library/Developer/CommandLineTools/SDKs/MacOSX15.sdk/usr/include/ffi -I/opt/homebrew/Cellar/glib/2.86.0/include/glib-2.0 -I/opt/homebrew/Cellar/glib/2.86.0/lib/glib-2.0/include -I/opt/homebrew/opt/gettext/include -I/opt/homebrew/Cellar/pcre2/10.46/include 
GTK3_LIBS =    -L/opt/homebrew/Cellar/gtk+3/3.24.50/lib -lgtk-3 -lgdk-3 -Wl,-framework,Cocoa -Wl,-framework,Carbon -Wl,-framework,CoreGraphics -L/opt/homebrew/Cellar/pango/1.57.0/lib -lpangocairo-1.0 -lpango-1.0 -L/opt/homebrew/Cellar/harfbuzz/12.0.0/lib -lharfbuzz -L/opt/homebrew/Cellar/cairo/1.18.4/lib -lcairo-gobject -lcairo -L/opt/homebrew/lib -lgdk_pixbuf-2.0 -L/opt/homebrew/Cellar/at-spi2-core/2.58.0/lib -latk-1.0 -L/opt/homebrew/Cellar/glib/2.86.0/lib -lgio-2.0 -lgobject-2.0 -lglib-2.0 -L/opt/homebrew/opt/gettext/lib -lintl -L/usr/X11/lib -lX11 -lm
#
# GLFW settings
#
GLFW_CFLAGS =  -I/opt/homebrew/Cellar/glfw/3.4/include
GLFW_LIBS =    -L/opt/homebrew/Cellar/glfw/3.4/lib -lglfw
#
# FFMPEG settings
#
FFMPEG_CFLAGS =  -I/opt/homebrew/Cellar/ffmpeg/8.0_1/include
FFMPEG_LIBS =    -L/opt/homebrew/Cellar/ffmpeg/8.0_1/lib -lavformat -lavcodec -lswscale
#
# -----------------------------------------------------------
# Directory lists
# -----------------------------------------------------------
#
SRCDIR = /Users/matsui/src_kemo
#
MAKEDIR = /Users/matsui/src_kemo/work
BUILDDIR = /Users/matsui/src_kemo/bin
MHDDIR = /Users/matsui/src_kemo/MHD
INSTDIR = /Users/matsui/local
PYTHONDIR= /Users/matsui/src_kemo/MHD/pythons
EXPDIR= /Users/matsui/src_kemo/examples
TESTDIR= /Users/matsui/src_kemo/tests
#
SPH_UTIL_BINDIR = $(BUILDDIR)/utilities
SPH_TEST_BINDIR = $(BUILDDIR)/tests
FEM_UTIL_BINDIR = $(BUILDDIR)/FEM_utils
#
#
# -----------------------------------------------------------
# library lists
# -----------------------------------------------------------
LIB_CALYPSO =      -lcalipso_kemo
LIB_CALYPSO_FILE = libcalipso_kemo.a
#
LIB_MESH =      -lkemo_core
LIB_MESH_FILE = libkemo_core.a
#
LIB_MODIFY_MESH =      -lmodify_mesh
LIB_MODIFY_MESH_FILE = libmodify_mesh.a

LIB_CALYPSO_ROCM =      -lkemo_ROCm
LIB_CALYPSO_ROCM_FILE = liblkemo_ROCm.a

#
LIB_SOLVER =      -lkemo_solver
LIB_SOLVER_FILE = libkemo_solver.a

LIB_PARA =      -lkemo_parallel
LIB_PARA_FILE = libkemo_parallel.a
#
LIB_MHD = -lkemo_MHD
LIB_MHD_FILE = libkemo_MHD.a
#
LIB_VIZ =      -lkemo_viz
LIB_VIZ_FILE = libkemo_viz.a

LIB_UTILS =       -lkemo_utils
LIB_UTILS_FILE =  libkemo_utils.a
#
LIB_GEN_FILTER =      -lcommute_3d
LIB_GEN_FILTER_FILE = libcommute_3d.a

LIB_ITP_TABLE =      -lgen_itp_table
LIB_ITP_TABLE_FILE = libgen_itp_table.a

LIB_CUBED_SPH =      -lcubed_sph_kemo
LIB_CUBED_SPH_FILE = libcubed_sph_kemo.a

LIB_PLANE_MODEL =      -lplane_model
LIB_PLANE_MODEL_FILE = libplane_model.a
#
LIB_PART_KEMO =      -lpart_kemo
LIB_PART_KEMO_FILE = libpart_kemo.a

LIB_REFINER =      -lrefine_kemo
LIB_REFINER_FILE = librefine_kemo.a

LIB_DRAW_PG =      -ldraw_by_pgplot
LIB_DRAW_PG_FILE = libdraw_by_pgplot.a

LIB_KEMO_C =      -lkemo_c
LIB_KEMO_C_FILE = libkemo_c.a

LIB_FFTPACK =      -lfftpack.5d
LIB_FFTPACK_FILE = libfftpack.5d.a

LIB_ISPACK =       -lispack_fft
LIB_ISPACK_FILE =  libispack_fft.a

LIB_ISPACK3 =      -lispack3_fft
LIB_ISPACK3_FILE = libispack3_fft.a

LIB_MT_STREAM =      -lmtstream_f-1.11
LIB_MT_STREAM_FILE = libmtstream_f-1.11.a

LIB_PYTHONS= \
-L$(PYTHONDIR) -lcalypso_to_pythons
LIB_FILE_PYTHONS= \
$(PYTHONDIR)/libcalypso_to_pythons.so
#
LIB_PYTHON_UTILS= \
$(LIB_MESH) $(LIB_KEMO_C)
LIB_FILES_PYTHON_UTILS= \
$(LIB_MESH_FILE) $(LIB_KEMO_C_FILE)
#
LIBS_MHD= \
$(LIB_MHD) $(LIB_VIZ) $(LIB_PARA) $(LIB_SOLVER) $(LIB_MESH) $(LIB_MT_STREAM) $(LIB_KEMO_C)
LIB_FILES_MHD= \
$(LIB_MHD_FILE) $(LIB_VIZ_FILE) $(LIB_PARA_FILE) $(LIB_SOLVER_FILE) $(LIB_MESH_FILE) $(LIB_MT_STREAM_FILE) $(LIB_KEMO_C_FILE)
#
LIBS_SPH_MHD= \
$(LIB_MHD) $(LIB_VIZ) $(LIB_PARA) $(LIB_SOLVER) $(LIB_MESH) $(LIB_MT_STREAM) $(LIB_FFTPACK) $(LIB_ISPACK) $(LIB_ISPACK3) $(LIB_NETLIB) $(LIB_KEMO_C)
LIB_FILES_SPH_MHD= \
$(LIB_MHD_FILE) $(LIB_VIZ_FILE) $(LIB_PARA_FILE) $(LIB_SOLVER_FILE) $(LIB_MESH_FILE) $(LIB_MT_STREAM_FILE) $(LIB_FFTPACK_FILE) $(LIB_ISPACK_FILE) $(LIB_ISPACK3_FILE) $(LIB_NETLIB_FILE) $(LIB_KEMO_C_FILE)
#
LIBS_VIZ= \
$(LIB_VIZ) $(LIB_PARA) $(LIB_SOLVER) $(LIB_MESH) $(LIB_MT_STREAM) $(LIB_KEMO_C)
LIB_FILES_VIZ= \
$(LIB_VIZ_FILE) $(LIB_PARA_FILE) $(LIB_SOLVER_FILE) $(LIB_MESH_FILE) $(LIB_MT_STREAM_FILE) $(LIB_KEMO_C_FILE)
#
LIBS_INTERPOLATE= \
$(LIB_UTILS) $(LIB_PARA) $(LIB_SOLVER) $(LIB_MESH) $(LIB_KEMO_C)
LIB_FILES_INTERPOLATE= \
$(LIB_UTILS_FILE) $(LIB_PARA_FILE) $(LIB_SOLVER_FILE) $(LIB_MESH_FILE) $(LIB_KEMO_C_FILE)
#
LIBS_COMMUTE= \
$(LIB_UTILS) $(LIB_PARA) $(LIB_SOLVER) $(LIB_MESH) $(LIB_KEMO_C)
LIB_FILES_COMMUTE= \
$(LIB_UTILS_FILE) $(LIB_PARA_FILE) $(LIB_SOLVER_FILE) $(LIB_MESH_FILE) $(LIB_KEMO_C_FILE)
#
LIBS_MESH_CHECK= \
$(LIB_PARA) $(LIB_SOLVER) $(LIB_MESH) $(LIB_KEMO_C)
LIB_FILES_MESH_CHECK= \
$(LIB_PARA_FILE) $(LIB_SOLVER_FILE) $(LIB_MESH_FILE) $(LIB_KEMO_C_FILE)
#
LIBS_MESH_UTIL= \
$(LIB_UTILS) $(LIB_VIZ) $(LIBS_MESH_CHECK) $(LIB_KEMO_C)
LIB_FILES_MESH_UTIL= \
$(LIB_UTILS_FILE) $(LIB_VIZ_FILE) $(LIB_FILES_MESH_CHECK) $(LIB_KEMO_C_FILE)
#
LIBS_CUBE_NOISE= \
$(LIBS_MESH_UTIL) $(LIB_MT_STREAM) $(LIB_KEMO_C)
LIB_FILES_CUBE_NOISE= \
$(LIB_FILES_MESH_UTIL) $(LIB_MT_STREAM_FILE) $(LIB_KEMO_C_FILE)
#
LIBS_MERGE= \
$(LIB_UTILS) $(LIB_PARA) $(LIB_SOLVER) $(LIB_MESH) $(LIB_FFTPACK) $(LIB_NETLIB) $(LIB_KEMO_C)
LIB_FILES_MERGE= \
$(LIB_UTILS_FILE) $(LIB_PARA_FILE) $(LIB_SOLVER_FILE) $(LIB_MESH_FILE) $(LIB_FFTPACK_FILE) $(LIB_NETLIB_FILE) $(LIB_KEMO_C_FILE)
#
LIBS_PSF_UTIL= \
$(LIB_UTILS) $(LIB_VIZ) $(LIB_PARA) $(LIB_SOLVER) $(LIB_MESH) $(LIB_KEMO_C)
LIB_FILES_PSF_UTIL= \
$(LIB_UTILS_FILE) $(LIB_VIZ_FILE) $(LIB_PARA_FILE) $(LIB_SOLVER_FILE) $(LIB_MESH_FILE) $(LIB_KEMO_C_FILE)
LIBS_PG_UTIL= \
$(LIB_DRAW_PG) $(LIB_MESH) $(LIB_KEMO_C)
LIB_FILES_PG_UTIL= \
$(LIB_DRAW_PG_FILE) $(LIB_MESH_FILE) $(LIB_KEMO_C_FILE)
#
LIBS_UDT_UTIL= \
$(LIB_UTILS) $(LIB_VIZ) $(LIB_PARA) $(LIB_SOLVER) $(LIB_MESH) $(LIB_KEMO_C)
LIB_FILES_UDT_UTIL= \
$(LIB_UTILS_FILE) $(LIB_VIZ_FILE) $(LIB_PARA_FILE) $(LIB_SOLVER_FILE) $(LIB_MESH_FILE) $(LIB_KEMO_C_FILE)
#
LIBS_SPH_UTILS= \
$(LIB_MHD) $(LIB_VIZ) $(LIB_PARA) $(LIB_SOLVER) $(LIB_MESH) $(LIB_MT_STREAM) $(LIB_FFTPACK) $(LIB_ISPACK) $(LIB_ISPACK3) $(LIB_NETLIB) $(LIB_KEMO_C)
LIB_FILES_SPH_UTILS= \
$(LIB_MHD_FILE) $(LIB_VIZ_FILE) $(LIB_PARA_FILE) $(LIB_SOLVER_FILE) $(LIB_MESH_FILE) $(LIB_MT_STREAM_FILE) $(LIB_FFTPACK_FILE) $(LIB_ISPACK_FILE) $(LIB_ISPACK3_FILE) $(LIB_NETLIB_FILE) $(LIB_KEMO_C_FILE)
#
LIBS_SPH_UTIL= \
$(LIB_VIZ) $(LIB_PARA) $(LIB_SOLVER) $(LIB_MESH) $(LIB_MT_STREAM) $(LIB_FFTPACK) $(LIB_ISPACK) $(LIB_ISPACK3) $(LIB_NETLIB) $(LIB_KEMO_C)
LIB_FILES_SPH_UTIL= \
$(LIB_VIZ_FILE) $(LIB_PARA_FILE) $(LIB_SOLVER_FILE) $(LIB_MESH_FILE) $(LIB_MT_STREAM_FILE) $(LIB_FFTPACK_FILE) $(LIB_ISPACK_FILE) $(LIB_ISPACK3_FILE) $(LIB_NETLIB_FILE) $(LIB_KEMO_C_FILE)
#
LIBS_PLANE_DATA= \
$(LIB_UTILS) $(LIB_PARA) $(LIB_SOLVER) $(LIB_MESH) $(LIB_FFTPACK) $(LIB_ISPACK) $(LIB_ISPACK3) $(LIB_NETLIB) $(LIB_KEMO_C)
LIB_FILES_PLANE_DATA= \
$(LIB_UTILS_FILE) $(LIB_PARA_FILE) $(LIB_SOLVER_FILE) $(LIB_MESH_FILE) $(LIB_FFTPACK_FILE) $(LIB_ISPACK_FILE) $(LIB_ISPACK3_FILE) $(LIB_NETLIB_FILE) $(LIB_KEMO_C_FILE)
#
LIB_RAYLEIGH_LINK= -lcalipso_rayleigh
LIB_RAYLEIGH_LINK_FILE= libcalipso_rayleigh.a
#
LIBS_RAYLEIGH_LINK= \
$(LIB_RAYLEIGH_LINK) $(LIB_VIZ) $(LIB_UTILS) $(LIB_PARA) $(LIB_SOLVER) $(LIB_MESH) $(LIB_MT_STREAM) $(LIB_FFTPACK) $(LIB_NETLIB) $(LIB_KEMO_C)
LIB_FILES_RAYLEIGH_LINK= \
$(LIB_RAYLEIGH_LINK_FILE) $(LIB_VIZ_FILE) $(LIB_UTILS_FILE) $(LIB_PARA_FILE) $(LIB_SOLVER_FILE) $(LIB_MESH_FILE) $(LIB_MT_STREAM_FILE) $(LIB_FFTPACK_FILE) $(LIB_NETLIB_FILE) $(LIB_KEMO_C_FILE)
#
LIBS_MESH_TEST= \
$(LIB_PARA) $(LIB_SOLVER) $(LIB_MESH) $(LIB_KEMO_C)
LIB_FILES_MESH_TEST= \
$(LIB_PARA_FILE) $(LIB_SOLVER_FILE) $(LIB_MESH_FILE) $(LIB_KEMO_C_FILE)
#
LIBS_COMM_TEST= \
$(LIB_PARA) $(LIB_SOLVER) $(LIB_MESH) $(LIB_KEMO_C)
LIB_FILES_COMM_TEST= \
$(LIB_PARA_FILE) $(LIB_SOLVER_FILE) $(LIB_MESH_FILE) $(LIB_KEMO_C_FILE)
#
LIBS_SOLVER_TEST= \
$(LIB_PARA) $(LIB_SOLVER) $(LIB_MESH) $(LIB_KEMO_C)
LIB_FILES_SOLVER_TEST= \
$(LIB_PARA_FILE) $(LIB_SOLVER_FILE) $(LIB_MESH_FILE) $(LIB_KEMO_C_FILE)
#
LIBS_FFT_TEST= \
$(LIB_MESH) $(LIB_FFTPACK) $(LIB_ISPACK) $(LIB_ISPACK3) $(LIB_NETLIB) $(LIB_KEMO_C)
LIB_FILES_FFT_TEST= \
$(LIB_MESH_FILE) $(LIB_FFTPACK_FILE) $(LIB_ISPACK_FILE) $(LIB_ISPACK3_FILE) $(LIB_NETLIB_FILE) $(LIB_KEMO_C_FILE)
#
LIBS_FDM_TEST= \
$(LIB_MHD) $(LIB_PARA) $(LIB_SOLVER) $(LIB_MESH) $(LIB_KEMO_C)
LIB_FILES_FDM_TEST= \
$(LIB_MHD_FILE) $(LIB_PARA_FILE) $(LIB_SOLVER_FILE) $(LIB_MESH_FILE) $(LIB_KEMO_C_FILE)
#
LIBS_BC_FILE_TEST= \
$(LIB_PARA) $(LIB_SOLVER) $(LIB_MESH) $(LIB_KEMO_C)
LIB_FILES_BCFILE_TEST= \
$(LIB_PARA_FILE) $(LIB_SOLVER_FILE) $(LIB_MESH_FILE) $(LIB_KEMO_C_FILE)
#
