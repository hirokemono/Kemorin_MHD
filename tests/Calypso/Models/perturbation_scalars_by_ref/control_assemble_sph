begin assemble_control
  begin data_files_def
    num_subdomain_ctl             1
!
    restart_file_prefix       'reference/reference_fields'
    restart_file_fmt_ctl       'ascii'
  end data_files_def
!
  begin new_data_files_def
    num_subdomain_ctl           1
    restart_file_prefix         'reference_fields'
    restart_file_fmt_ctl        'ascii'
  end new_data_files_def
!
!
  file spherical_shell_ctl        'control_resolution_l0'
  file new_spherical_shell_ctl    'control_resolution_l0'
!
  begin control
!!!!!  information for time integration
    begin time_step_ctl
      i_step_init_ctl         0
      i_step_number_ctl       0
      i_step_rst_ctl          1
    end time_step_ctl
  end control
end assemble_control

