array compare_surface_file
  begin compare_surface_file
    begin first_file_ctl
      section_file_prefix    'isosurface/iso_w10n'
      section_file_format            VTK
    end first_file_ctl
    begin second_file_ctl
      section_file_prefix    'isosurface/iso_w10n'
      section_file_format            VTK
    end second_file_ctl
!
    i_step_surface_ctl      10
    difference_limit_ctl    1.0e-9
  end compare_surface_file
!
  begin compare_surface_file
    begin first_file_ctl
      section_file_prefix    'psf/iso_w10n'
      section_file_format            UDT
    end first_file_ctl
    begin second_file_ctl
      section_file_prefix    'psf/iso_w10n'
      section_file_format            UDT_GZ
    end second_file_ctl
!
    i_step_surface_ctl      10
    difference_limit_ctl    1.0e-9
  end compare_surface_file
end array compare_surface_file
